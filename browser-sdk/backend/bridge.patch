+const NS = "ring3.runtime.v1";
+type Phase = "ready" | "loading" | "running" | "paused" | "stopped" | "error";
+type Operation = "pause" | "resume" | "status" | "stop";
+type Facts = Record<string, unknown>;
+export type RuntimeSdkBridge = ReturnType<typeof installRuntimeBridge>;
+let nextControl = 0;
+let activeOwner: object | null = null;
+let activePagehide: (() => void) | null = null;
+
+export function requestSdkControl(worker: Worker, operation: Operation): Promise<Facts> {
+    const id = `ring3-sdk:${++nextControl}`;
+    return new Promise((resolve, reject) => {
+        const cleanup = () => { clearTimeout(timer); worker.removeEventListener("message", receive); };
+        const receive = (event: MessageEvent) => {
+            const m = event.data;
+            if (m?.type !== "ring3_sdk_control_reply" || m.id !== id) return;
+            cleanup();
+            if (m.ok) resolve(m.result);
+            else reject(new Error(String(m.error ?? "runtime control failed")));
+        };
+        const timer = setTimeout(() => { cleanup(); reject(new Error(`${operation} timed out`)); }, 180000);
+        worker.addEventListener("message", receive);
+        try { worker.postMessage({ type: "ring3_sdk_control", id, operation }); }
+        catch (error) { cleanup(); reject(error); }
+    });
+}
+
+export function installRuntimeBridge(hooks: {
+    launch(url: string, options: { preload: boolean; args?: string }): Promise<void>;
+    control(operation: Operation): Promise<Facts>;
+    dispose(): void;
+}) {
+    const q = new URLSearchParams(location.search);
+    if (q.get("ring3Sdk") !== "1" || window.parent === window) return null;
+    const session = q.get("ring3Session") ?? "", generation = Number(q.get("ring3Generation"));
+    if (!/^[a-zA-Z0-9_-]{8,128}$/.test(session) || !Number.isSafeInteger(generation) || generation < 1) {
+        throw new Error("invalid Ring3 SDK session");
+    }
+    const key = `ring3-sdk:${session}:${generation}`;
+    const stored = JSON.parse(sessionStorage.getItem(key) ?? "{}");
+    let sequence = Number.isSafeInteger(stored.sequence) && stored.sequence >= 0 ? stored.sequence : 0;
+    let launched = stored.launched === true, busy = false, disposed = false, lastId = 0, presented = false, stopCompleted = false;
+    const state: { phase: Phase; paused: boolean; [key: string]: unknown } = {
+        phase: launched ? "loading" : "ready", paused: false, workerReady: false, firstPresent: false,
+    };
+    const save = () => sessionStorage.setItem(key, JSON.stringify({ sequence, launched }));
+    const emit = (type: "ready" | "state") => {
+        sequence++; save();
+        window.parent.postMessage({ namespace: NS, type, session, generation, sequence, state: { ...state } }, location.origin);
+    };
+    const setPaused = (paused: boolean) => {
+        if (disposed || state.phase === "stopped" || state.phase === "error") return;
+        state.hostPauseRequested = paused;
+        emit("state");
+    };
+    const reply = (id: number, ok: boolean, value: unknown) => window.parent.postMessage({
+        namespace: NS, type: "reply", session, generation, id, ok,
+        ...(ok ? { result: value } : { error: { code: "RUNTIME_CONTROL", message: String(value) } }),
+    }, location.origin);
+    const receive = async (event: MessageEvent) => {
+        const m = event.data;
+        if (disposed || event.origin !== location.origin || event.source !== window.parent || m?.namespace !== NS
+            || m.type !== "request" || m.session !== session || m.generation !== generation) return;
+        if (!Number.isSafeInteger(m.id) || m.id <= lastId) return;
+        lastId = m.id;
+        if (!["launch", "pause", "resume", "status", "stop"].includes(m.method)) { reply(m.id, false, "unsupported method"); return; }
+        if (busy) {
+            if (m.method === "status") reply(m.id, true, { ...state, busy: true });
+            else reply(m.id, false, "runtime control busy");
+            return;
+        }
+        busy = true;
+        try {
+            if (m.method === "launch") {
+                if (launched || state.phase === "stopped") throw new Error("one launch per SDK generation");
+                const p = m.params ?? {}, url = new URL(String(p.url ?? ""), location.href);
+                if (url.origin !== location.origin || url.username || url.password || !url.href.toLowerCase().endsWith(".wgb") || url.hash
+                    || (p.preload !== undefined && typeof p.preload !== "boolean")
+                    || (p.args !== undefined && (typeof p.args !== "string" || p.args.length > 4096))) throw new Error("invalid local WGB launch");
+                launched = true; save(); state.phase = "loading"; state.paused = false; emit("state");
+                await hooks.launch(url.href, { preload: p.preload === true, args: p.args });
+                reply(m.id, true, { accepted: true, state: { ...state } });
+            } else if (m.method === "status") {
+                if (state.phase !== "stopped") {
+                    const facts = await hooks.control("status");
+                    state.native = facts;
+                    if (presented && facts.paused === true && facts.running === false) { state.phase = "paused"; state.paused = true; }
+                    else if (presented && facts.paused === false && facts.running === true) { state.phase = "running"; state.paused = false; }
+                }
+                reply(m.id, true, { ...state });
+            } else {
+                if (stopCompleted) {
+                    if (m.method !== "stop") throw new Error("runtime stopped");
+                } else {
+                    if (m.method !== "stop" && (!presented || !["running", "paused"].includes(state.phase))) throw new Error("no running guest");
+                    state.native = await hooks.control(m.method);
+                    if (m.method === "stop") { stopCompleted = true; state.phase = "stopped"; state.paused = true; }
+                    else { state.phase = m.method === "pause" ? "paused" : "running"; state.paused = m.method === "pause"; }
+                    emit("state");
+                }
+                reply(m.id, true, { ...state });
+            }
+        } catch (error) {
+            state.phase = "error";
+            state.error = error instanceof Error ? error.message : String(error);
+            emit("state");
+            reply(m.id, false, state.error);
+        } finally { busy = false; }
+    };
+    const owner = {};
+    let runtimeDisposed = false;
+    const forceDispose = () => {
+        if (runtimeDisposed || activeOwner !== owner) return;
+        runtimeDisposed = true;
+        disposed = true;
+        window.removeEventListener("message", receive);
+        window.removeEventListener("pagehide", forceDispose);
+        activePagehide = null;
+        activeOwner = null;
+        hooks.dispose();
+    };
+    const dispose = () => {
+        if (disposed) return;
+        disposed = true;
+        window.removeEventListener("message", receive);
+        // StrictMode replays setup synchronously; only the surviving owner may end the runtime.
+        queueMicrotask(forceDispose);
+    };
+    if (activePagehide) window.removeEventListener("pagehide", activePagehide);
+    activeOwner = owner;
+    activePagehide = forceDispose;
+    window.addEventListener("message", receive);
+    window.addEventListener("pagehide", forceDispose);
+    emit("ready");
+    return {
+        setPaused,
+        observe(m: any) {
+            if (disposed || state.phase === "stopped") return;
+            if (m?.type === "ready") state.workerReady = true;
+            else if (m?.type === "first_present") {
+                presented = true; state.firstPresent = true; state.phase = state.paused ? "paused" : "running";
+            } else if (m?.type === "loading_progress") {
+                state.progress = { phase: String(m.phase ?? "").slice(0, 64), percent: Number(m.percent) || 0, label: String(m.label ?? "").slice(0, 512) };
+            } else if (m?.type === "fpu_strict_state") state.fpuStrict = !!m.strict;
+            else if (m?.type === "app_resize") state.resolution = { width: m.width, height: m.height };
+            else if (m?.type === "reexec") { state.phase = "loading"; state.restarting = true; }
+            else if (m?.type === "process_exit") { state.phase = "stopped"; state.exit = { code: m.exitCode, crashed: !!m.crashed }; }
+            else if (m?.type === "error") { state.phase = "error"; state.error = String(m.message ?? "runtime error").slice(0, 2048); }
+            else return;
+            emit("state");
+        },
+        dispose,
+    };
+}
diff --git a/tools/tests/sdk-child-stop.test.ts b/tools/tests/sdk-child-stop.test.ts
new file mode 100644
--- /dev/null
+++ b/tools/tests/sdk-child-stop.test.ts
@@ -0,0 +1,105 @@
+import { expect, test } from "bun:test";
+import {
+    ChildProcessCancelled, startChildExecution, startChildProcess,
+    stopChildProcesses, setChildDrainBudgetForTests, clearChildShutdownDebtsForTests,
+} from "../../src/worker/core/child-process";
+import { setChildVfsCloseBudgetForTests } from "../../src/worker/core/child-vfs";
+import type { VirtualFileSystem } from "../../src/worker/runtime/filesystem/vfs";
+
+const request = { imagePath: "C:\\helper.exe", commandLine: "helper.exe", currentDirectory: "C:\\" };
+const fakeVfs = (flushAll: () => Promise<void>) => ({ flushAll }) as VirtualFileSystem;
+const tasks: Array<{ completion: Promise<number> }> = [];
+function child(vfs: VirtualFileSystem, cleanup: () => void | Promise<void>) {
+    const task = startChildExecution(vfs, request, context => {
+        context.onStop(cleanup);
+        return new Promise<number>((_, reject) => context.signal.addEventListener("abort", () => reject(new ChildProcessCancelled()), { once: true }));
+    });
+    void task.completion.catch(() => {}); tasks.push(task); return task;
+}
+async function until(check: () => boolean) {
+    for (let i = 0; i < 1000; i++) {
+        if (check()) return;
+        await new Promise(r => setTimeout(r, 1));
+    }
+    throw new Error("fixture did not reach child I/O");
+}
+
+test("SDK strict stop propagates child drain failures/timeouts and retains failed work for retry", async () => {
+    clearChildShutdownDebtsForTests();
+    setChildDrainBudgetForTests(50);
+    setChildVfsCloseBudgetForTests(10);
+    let releaseCleanup = () => {}, releaseTransport = () => {}, releaseOldFlush = () => {};
+    try {
+        let cleaned = false, flushes = 0;
+        child(fakeVfs(async () => { flushes++; }), async () => { await Promise.resolve(); cleaned = true; });
+        await stopChildProcesses(false, true);
+        expect(cleaned).toBe(true);
+        expect(flushes).toBe(1);
+
+        let release!: () => void;
+        const cleanup = new Promise<void>(r => { release = r; }); releaseCleanup = release;
+        child(fakeVfs(async () => {}), () => cleanup);
+        await expect(stopChildProcesses(false, true)).rejects.toThrow("timed out");
+        release();
+        await stopChildProcesses(false, true);
+
+        let finishOldFlush!: () => void, oldFlushAttempts = 0;
+        const oldFlush = new Promise<void>(r => { finishOldFlush = r; }); releaseOldFlush = finishOldFlush;
+        const prior = startChildExecution(fakeVfs(async () => { if (++oldFlushAttempts === 1) await oldFlush; }), request, async () => 0);
+        void prior.completion.catch(() => {}); tasks.push(prior);
+        expect(await prior.completion).toBe(0);
+        expect(oldFlushAttempts).toBe(1);
+        await expect(stopChildProcesses(false, true)).rejects.toThrow("prior vfs.flushAll timed out");
+        expect(oldFlushAttempts).toBe(1);
+        finishOldFlush();
+        await stopChildProcesses(false, true);
+        expect(oldFlushAttempts).toBe(2);
+
+        let failing = true, attempts = 0;
+        child(fakeVfs(async () => { attempts++; if (failing) throw new Error("storage commit refused"); }), () => {});
+        await expect(stopChildProcesses(false, true)).rejects.toThrow("storage commit refused");
+        failing = false;
+        await stopChildProcesses(false, true);
+        expect(attempts).toBe(2);
+
+        let finish!: () => void, dispatched = false;
+        const pending = new Promise<void>(r => { finish = r; }); releaseTransport = finish;
+        let emit: ((data: unknown) => void) | null = null;
+        const worker = {
+            postMessage(m: any) {
+                if (m.type === "child_boot") queueMicrotask(() => {
+                    emit!({ type: "child_io", request: { method: "flushAll", args: [] } });
+                    emit!({ type: "process_exit", exitCode: 0 });
+                });
+            },
+            terminate() {},
+            set onmessage(fn: ((event: { data: unknown }) => void) | null) { emit = fn ? data => fn({ data }) : null; },
+            set onerror(_: unknown) {}, set onmessageerror(_: unknown) {},
+        } as unknown as Worker;
+        const image = { path: request.imagePath };
+        let transportFlushes = 0;
+        const vfs = {
+            open: async () => image, getFileSize: () => 4, read: async () => new Uint8Array(4),
+            flushAll: async () => { transportFlushes++; dispatched = true; if (transportFlushes === 1) await pending; },
+        } as unknown as VirtualFileSystem;
+        const task = startChildProcess(vfs, request, () => worker);
+        void task.completion.catch(() => {}); tasks.push(task);
+        await until(() => dispatched);
+        expect(await task.completion).toBe(0);
+        expect(transportFlushes).toBe(2);
+        await expect(stopChildProcesses(false, true)).rejects.toThrow("transport drain timed out");
+        finish();
+        await stopChildProcesses(false, true);
+
+        child(fakeVfs(async () => {}), () => { throw new Error("child resource close refused"); });
+        await expect(stopChildProcesses(false, true)).rejects.toThrow("child resource close refused");
+        await expect(stopChildProcesses(false, true)).rejects.toThrow("child resource close refused");
+    } finally {
+        releaseCleanup(); releaseTransport(); releaseOldFlush();
+        await stopChildProcesses();
+        await Promise.allSettled(tasks.map(task => task.completion));
+        clearChildShutdownDebtsForTests();
+        setChildDrainBudgetForTests(30000);
+        setChildVfsCloseBudgetForTests(30000);
+    }
+});
diff --git a/tools/tests/sdk-vfs-strict-stop.test.ts b/tools/tests/sdk-vfs-strict-stop.test.ts
new file mode 100644
--- /dev/null
+++ b/tools/tests/sdk-vfs-strict-stop.test.ts
@@ -0,0 +1,56 @@
+import { afterAll, expect, test } from "bun:test";
+import { VirtualFileSystem } from "../../src/worker/runtime/filesystem/vfs";
+import type { ZipArchive } from "@bottleship/formats/zip";
+import { installFakeOpfs, findFakeByName } from "./fixtures/fake-opfs";
+
+const savedNavigator = globalThis.navigator;
+afterAll(() => { (globalThis as unknown as { navigator: unknown }).navigator = savedNavigator; });
+let sequence = 0;
+interface WriterEntry { writer: { close(): Promise<void> } | null }
+interface Overlay {
+    writerCache: Map<string, WriterEntry>;
+    flushWriteBuffer(entry: WriterEntry): Promise<void>;
+}
+async function fresh() {
+    const root = installFakeOpfs();
+    const vfs = new VirtualFileSystem();
+    vfs.mountRom(null as unknown as ZipArchive, "rom", new Map());
+    await vfs.initOverlay(`test:sdk-strict-${++sequence}`);
+    const overlay = (vfs as unknown as { overlay: Overlay }).overlay;
+    return { root, vfs, overlay };
+}
+
+test("SDK strict storage barrier retains a real swallowed writer-close failure", async () => {
+    const { root, vfs, overlay } = await fresh();
+    const path = "C:\\save.bin";
+    const handle = vfs.openSync(path, 0x40000000, 2)!;
+    expect(vfs.writeSync(handle, new Uint8Array([0xaa, 0xbb]))).toBe(2);
+    const entry = overlay.writerCache.get(path.toLowerCase())!;
+    await overlay.flushWriteBuffer(entry);
+    expect(entry.writer).toBeTruthy();
+    const writer = entry.writer!, close = writer.close.bind(writer);
+    writer.close = async () => { throw new Error("fixture OPFS close denied"); };
+    try {
+        // the real default close path consumes its writer and logs the failure.
+        await expect(vfs.flushFile(path)).resolves.toBeUndefined();
+        expect(overlay.writerCache.has(path.toLowerCase())).toBe(false);
+        expect([...findFakeByName(root, "save.bin")!.data]).not.toEqual([0xaa, 0xbb]);
+        await expect(vfs.flushAll()).resolves.toBeUndefined();
+        await expect(vfs.flushAll(true)).rejects.toThrow("fixture OPFS close denied");
+        writer.close = close;
+        // removing the fault does not reconstruct already-discarded accepted bytes.
+        await expect(vfs.flushAll(true)).rejects.toThrow("fixture OPFS close denied");
+        expect([...findFakeByName(root, "save.bin")!.data]).not.toEqual([0xaa, 0xbb]);
+    } finally {
+        writer.close = close;
+        await vfs.flushAll();
+    }
+});
+
+test("SDK strict storage barrier commits a separate healthy real overlay", async () => {
+    const { root, vfs } = await fresh();
+    const handle = vfs.openSync("C:\\healthy.bin", 0x40000000, 2)!;
+    expect(vfs.writeSync(handle, new Uint8Array([0x12, 0x34, 0x56]))).toBe(3);
+    await expect(vfs.flushAll(true)).resolves.toBeUndefined();
+    expect([...findFakeByName(root, "healthy.bin")!.data]).toEqual([0x12, 0x34, 0x56]);
+});
diff --git a/tools/tests/sdk-registry-strict-stop.test.ts b/tools/tests/sdk-registry-strict-stop.test.ts
new file mode 100644
--- /dev/null
+++ b/tools/tests/sdk-registry-strict-stop.test.ts
@@ -0,0 +1,82 @@
+import { afterAll, expect, test } from "bun:test";
+import { RegistryStore } from "../../src/worker/runtime/filesystem/registry";
+import { FakeFileHandle, installFakeOpfs, findFakeByName } from "./fixtures/fake-opfs";
+
+const savedNavigator = globalThis.navigator;
+const originalWriter = FakeFileHandle.prototype.createWritable;
+afterAll(() => {
+    (globalThis as unknown as { navigator: unknown }).navigator = savedNavigator;
+    FakeFileHandle.prototype.createWritable = originalWriter;
+});
+
+test("SDK registry stop rejects a failed commit and persists the retained hive on retry", async () => {
+    const root = installFakeOpfs();
+    const registry = new RegistryStore();
+    registry.setGameId("test:sdk-registry-stop");
+    const { key } = registry.createKey("HKCU", "Software\\SdkStop");
+    registry.setValue(key, "Saved", { name: "Saved", type: "REG_SZ", data: "retained" });
+    FakeFileHandle.prototype.createWritable = async function (options) {
+        const writer = await originalWriter.call(this, options);
+        if (this.name === "registry.json") writer.close = async () => { throw new Error("registry commit refused"); };
+        return writer;
+    };
+    try {
+        await expect(registry.flush()).resolves.toBeUndefined();
+        await expect(registry.flush(true)).rejects.toThrow("registry commit refused");
+        expect(findFakeByName(root, "registry.json")!.data.length).toBe(0);
+        FakeFileHandle.prototype.createWritable = originalWriter;
+        await expect(registry.flush(true)).resolves.toBeUndefined();
+        const saved = JSON.parse(new TextDecoder().decode(findFakeByName(root, "registry.json")!.data));
+        expect(saved.keys["hkcu\\software\\sdkstop"].saved.data).toBe("retained");
+    } finally { FakeFileHandle.prototype.createWritable = originalWriter; }
+});
+
+test("SDK registry stop rejects inaccessible storage; a child without a container remains a no-op", async () => {
+    installFakeOpfs();
+    const storage = navigator.storage.getDirectory;
+    navigator.storage.getDirectory = async () => { throw new Error("registry storage unavailable"); };
+    const owner = new RegistryStore();
+    owner.setGameId("test:sdk-registry-unavailable");
+    try {
+        await expect(owner.flush()).resolves.toBeUndefined();
+        await expect(owner.flush(true)).rejects.toThrow("registry directory");
+        await expect(new RegistryStore().flush(true)).resolves.toBeUndefined();
+    } finally { navigator.storage.getDirectory = storage; }
+});
+
+test("the latest strict registry snapshot follows an already-running autosave", async () => {
+    const root = installFakeOpfs();
+    const registry = new RegistryStore();
+    registry.setGameId("test:sdk-registry-order");
+    const { key } = registry.createKey("HKCU", "Software\\SdkStop");
+    registry.setValue(key, "Saved", { name: "Saved", type: "REG_SZ", data: "older" });
+    let release!: () => void, started!: () => void, first = true;
+    const gate = new Promise<void>(resolve => { release = resolve; });
+    const waiting = new Promise<void>(resolve => { started = resolve; });
+    FakeFileHandle.prototype.createWritable = async function (options) {
+        const writer = await originalWriter.call(this, options);
+        if (this.name === "registry.json" && first) {
+            first = false;
+            const close = writer.close.bind(writer);
+            writer.close = async () => { started(); await gate; await close(); };
+        }
+        return writer;
+    };
+    let older: Promise<void> | undefined, latest: Promise<void> | undefined;
+    try {
+        older = registry.flush();
+        await waiting;
+        registry.setValue(key, "Saved", { name: "Saved", type: "REG_SZ", data: "latest" });
+        latest = registry.flush(true);
+        // Let every unblocked fake-storage promise settle while the old close is held.
+        await new Promise(resolve => setTimeout(resolve, 0));
+        release();
+        await Promise.all([older, latest]);
+        const saved = JSON.parse(new TextDecoder().decode(findFakeByName(root, "registry.json")!.data));
+        expect(saved.keys["hkcu\\software\\sdkstop"].saved.data).toBe("latest");
+    } finally {
+        release();
+        await Promise.allSettled([older, latest]);
+        FakeFileHandle.prototype.createWritable = originalWriter;
+    }
+});
diff --git a/tools/tests/sdk-runtime-bridge-owner.test.ts b/tools/tests/sdk-runtime-bridge-owner.test.ts
new file mode 100644
--- /dev/null
+++ b/tools/tests/sdk-runtime-bridge-owner.test.ts
@@ -0,0 +1,58 @@
+import { expect, test } from "bun:test";
+import { installRuntimeBridge } from "../../src/app/runtime-bridge";
+
+test("SDK bridge StrictMode replay retains runtime ownership, while unmount and pagehide contain it", async () => {
+    const names = ["window", "location", "sessionStorage"] as const;
+    const original = names.map(name => Object.getOwnPropertyDescriptor(globalThis, name));
+    const host = Object.assign(new EventTarget(), { parent: { postMessage() {} } });
+    const stored = new Map<string, string>();
+    const globals = {
+        window: host,
+        location: new URL("http://localhost/?ring3Sdk=1&ring3Session=strictmode-test&ring3Generation=1"),
+        sessionStorage: { getItem: (key: string) => stored.get(key) ?? null, setItem: (key: string, value: string) => { stored.set(key, value); } },
+    };
+    for (const name of names) Object.defineProperty(globalThis, name, { configurable: true, writable: true, value: globals[name] });
+    const closed = [0, 0, 0, 0];
+    const mount = (index: number) => {
+        const bridge = installRuntimeBridge({ launch: async () => {}, control: async () => ({}), dispose: () => { closed[index]++; } });
+        expect(bridge).not.toBeNull();
+        return bridge!;
+    };
+    try {
+        const first = mount(0);
+        first.dispose();
+        expect(closed).toEqual([0, 0, 0, 0]);
+        const replay = mount(1);
+        await Promise.resolve();
+        expect(closed).toEqual([0, 0, 0, 0]);
+        host.dispatchEvent(new Event("pagehide"));
+        expect(closed).toEqual([0, 1, 0, 0]);
+        replay.dispose();
+        await Promise.resolve();
+        expect(closed).toEqual([0, 1, 0, 0]);
+
+        const unmount = mount(2);
+        unmount.dispose();
+        expect(closed[2]).toBe(0);
+        await Promise.resolve();
+        expect(closed[2]).toBe(1);
+        unmount.dispose();
+        await Promise.resolve();
+        expect(closed[2]).toBe(1);
+
+        const leave = mount(3);
+        leave.dispose();
+        host.dispatchEvent(new Event("pagehide"));
+        expect(closed[3]).toBe(1);
+        await Promise.resolve();
+        expect(closed).toEqual([0, 1, 1, 1]);
+    } finally {
+        host.dispatchEvent(new Event("pagehide"));
+        await Promise.resolve();
+        names.forEach((name, index) => {
+            const descriptor = original[index];
+            if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+            else Reflect.deleteProperty(globalThis, name);
+        });
+    }
+});
