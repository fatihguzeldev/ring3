{
  "name": "ring3-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the ring3 compatibility runtime library.",
  "engines": {
    "node": "22.16.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm build:rust && pnpm build:wasm && pnpm build:typescript",
    "build:rust": "cargo build --workspace --locked",
    "build:typescript": "pnpm --filter @ring3/runtime build",
    "build:wasm": "cargo build --workspace --locked --target wasm32-unknown-unknown",
    "corpus:build": "node tools/build-corpus.mjs",
    "corpus:build:imports": "node tools/build-import-corpus.mjs",
    "corpus:build:ordinals": "node tools/build-import-corpus.mjs --ordinal",
    "corpus:build:forwarders": "node tools/build-forwarder-corpus.mjs",
    "corpus:build:pe32plus": "node tools/build-pe32plus-corpus.mjs",
    "corpus:test": "node --test tools/build-corpus.test.mjs tools/build-import-corpus.test.mjs tools/build-ordinal-corpus.test.mjs tools/build-forwarder-corpus.test.mjs tools/build-pe32plus-corpus.test.mjs tools/verify-corpus.test.mjs tools/build-relocation-corpus.test.mjs tools/build-tls-corpus.test.mjs tools/build-delay-corpus.test.mjs",
    "corpus:verify": "node tools/verify-corpus.mjs",
    "format:rust": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "preinstall": "node tools/verify-toolchain.mjs",
    "toolchain:check": "node tools/verify-toolchain.mjs",
    "typecheck": "pnpm --filter @ring3/runtime typecheck",
    "corpus:build:relocations": "node tools/build-relocation-corpus.mjs",
    "corpus:build:tls": "node tools/build-tls-corpus.mjs",
    "corpus:build:delay": "node tools/build-delay-corpus.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
