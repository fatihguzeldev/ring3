{
  "name": "ring3-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the ring3 compatibility runtime library.",
  "engines": {
    "node": "22.16.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm build:rust && pnpm build:wasm && pnpm build:typescript",
    "build:rust": "cargo build --workspace --locked",
    "build:typescript": "pnpm --filter @ring3/runtime build",
    "build:wasm": "cargo build --workspace --locked --target wasm32-unknown-unknown",
    "corpus:build": "node tools/corpus/build-pe32.mjs",
    "corpus:build:imports": "node tools/corpus/build-imports.mjs",
    "corpus:build:ordinals": "node tools/corpus/build-imports.mjs --ordinal",
    "corpus:build:forwarders": "node tools/corpus/build-forwarders.mjs",
    "corpus:build:pe32plus": "node tools/corpus/build-pe32plus.mjs",
    "corpus:test": "node --test tools/corpus/build-pe32.test.mjs tools/corpus/build-imports.test.mjs tools/corpus/build-import-ordinals.test.mjs tools/corpus/build-forwarders.test.mjs tools/corpus/build-pe32plus.test.mjs tools/corpus/verify.test.mjs tools/corpus/build-relocations.test.mjs tools/corpus/build-tls.test.mjs tools/corpus/build-delay-imports.test.mjs tools/corpus/build-delay-ordinals.test.mjs tools/corpus/build-resources.test.mjs tools/corpus/build-debug-payloads.test.mjs tools/corpus/build-managed.test.mjs",
    "corpus:verify": "node tools/corpus/verify.mjs",
    "format:rust": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --workspace --locked",
    "preinstall": "node tools/verify-toolchain.mjs",
    "toolchain:check": "node tools/verify-toolchain.mjs",
    "typecheck": "pnpm --filter @ring3/runtime typecheck",
    "corpus:build:relocations": "node tools/corpus/build-relocations.mjs",
    "corpus:build:tls": "node tools/corpus/build-tls.mjs",
    "corpus:build:delay": "node tools/corpus/build-delay-imports.mjs",
    "corpus:build:delay-ordinals": "node tools/corpus/build-delay-imports.mjs --ordinal",
    "corpus:build:resources": "node tools/corpus/build-resources.mjs",
    "corpus:build:debug": "node tools/corpus/build-debug-payloads.mjs",
    "corpus:build:managed": "node tools/corpus/build-managed.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
